!
! Non-hydrostatic (NBQ) version: NDTFAST is set by the acoustic CFL
! of the reduced sound speed CSOUND_NBQ (150 m/s > sqrt(g H)):
! dtfast = dt/NDTFAST = 0.75 s, c dtfast sqrt(1/dx2+1/dy2) < 0.75.
!
!
! FJORD test case with FJORD_GLACIER: marine-terminating glacier at
! the head (subglacial plume, ICEPLUME). Sill, tide, exchange flow and
! wind remain optional (cppdefs.h).
! Recommended with FJORD_GREENLAND (cold Polar Water over
! Atlantic Water). The glacier is the masked column i=LLm=240; the
! plume cell is the wet cell i=239 (found by iceplume_init).
!
title:
        FJORD: idealized fjord with a tidewater glacier (ICEPLUME)
time_stepping: NTIMES   dt[sec]  NDTFAST  NINFO
               86400     30       40       60
time_stepping_nbq: NDTNBQ    CSOUND_NBQ    VISC2_NBQ
                     1          150.         1.
S-coord: THETA_S,   THETA_B,    Hc (m)
           5.0d0     1.0d0      10.0d0
initial: NRREC  filename
          0
                          fjord_glacier_nbq_ini.nc
restart:          NRST, NRPFRST / filename
                   28800    -1
                          fjord_glacier_nbq_rst.nc
history: LDEFHIS, NWRT, NRPFHIS / filename
            T     120     0
                          fjord_glacier_nbq_his.nc
averages: NTSAVG, NAVG, NRPFAVG / filename
            1     3000     0
                          fjord_glacier_nbq_avg.nc
primary_history_fields: zeta UBAR VBAR  U  V   wrtT(1:NT)
                          T    T   T   T  T    30*T
auxiliary_history_fields:   rho Omega  W  Akv  Akt  Aks Visc3d Diff3d  HBL HBBL Bostr Wstr Ustr Vstr Shfl Swfl rsw rlw lat sen  HEL
                             T   F     T   T    T    T    F     F       F   F    T     F    F    F    F    F   10*F
gls_history_fields:   TKE  GLS  Lscale
                       T     F    F
primary_averages: zeta UBAR VBAR  U  V   wrtT(1:NT)
                   T    T    T    T  T   30*T
auxiliary_averages:   rho Omega  W  Akv  Akt  Aks Visc3d Diff3d  HBL HBBL Bostr Wstr Ustr Vstr Shfl Swfl rsw rlw lat sen  HEL
                       T   F     T   T    T    T    F     F       F   F    T     F    F    F    F    F   10*F
gls_averages:   TKE  GLS  Lscale
                 T     F    F
rho0:
      1025.d0
lateral_visc:   VISC2,    VISC4    [m^2/sec for all]
                 1.0       0.
tracer_diff2: TNU2(1:NT)           [m^2/sec for all]
               30*0.d0
bottom_drag:     RDRG [m/s],  RDRG2,  Zob [m],  Cdb_min, Cdb_max
                 0.0d-03      0.0d-3  1.0d-3     1.d-4    1.d-1
gamma2:
                 1.d0
sponge:          X_SPONGE [m],    V_SPONGE [m^2/sec]
                    2000.               20.
nudg_cof:    TauT_in, TauT_out, TauM_in, TauM_out  [days for all]
                0.5      10.      0.5      10.
!
! Point source at the glacier face (u-face Isrc=240, Dsrc=0) with no
! conventional river discharge (Qbar=0). Tracers: T S tpas01 tpas02.
!
psource:   Nsrc  Isrc  Jsrc  Dsrc  Qbar [m3/s]    Lsrc        Tsrc
            1
                  240   8     0     0.    T T T T  0. 0. 0. 0.
!
! ICEPLUME: SG_typ SG_dep SG_len SG_bar SG_trc(1:NT) Istr Iend Jstr Jend
!   type 3 (finite line plume), grounding line at the bottom (dep>=0),
!   250 m wide (one cell), 200 m3/s, T=0 C, S=0, tpas01=1 (discharge
!   tracer), tpas02=0; DET_AVERAGE window i=233..239, j=1..16.
!
iceplume:  SG_typ SG_dep SG_len SG_bar  SG_trc(1:NT)  Irange Jrange
                3    1.    250.    200.   0. 0. 1. 0.   233 239  1 16
